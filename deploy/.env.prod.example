# Copy to /opt/rh-chain-trader/.env on the VPS (never commit real values).

POSTGRES_USER=rh_research
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=rh_chain
DATABASE_URL=postgresql://rh_research:CHANGE_ME_LONG_RANDOM@postgres:5432/rh_chain

API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=https://research.example.com

CHAIN_ID=4663
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com
# Alchemy / QuickNode / Dwellir HTTPS URL for Robinhood Chain
RPC_URL=

# X API public discovery (opt-in; set provider spending limits before enabling)
X_DISCOVERY_ENABLED=false
X_BEARER_TOKEN=
X_POLL_MS=300000
X_ACCOUNTS_PER_TICK=1
X_GRAPH_INTERVAL_MS=3600000
X_MAX_GRAPH_USERS=10000

PROJECT_RESEARCH_ENABLED=false
# Optional paid xAI analysis. Configure provider spending limits and a supported model before enabling.
GROK_RESEARCH_ENABLED=false
XAI_API_KEY=
XAI_MODEL=
# Optional WSS for live logs
# RPC_WSS_URL=

# Collector paper ingest
COLLECTOR_POLL_MS=15000
LOG_BLOCK_WINDOW=2000
COLLECTOR_LOOKBACK_BLOCKS=5000

VITE_API_BASE_URL=https://research.example.com

# Telegram is the primary interface. Keep existing bot/chat settings in the VPS secret environment.
TELEGRAM_BOT_TOKEN=
# Separate random service secret, at least 32 characters; shared ONLY by API and Telegram worker.
# Never give it to the collector, Grok, a browser, or proposal payloads.
TELEGRAM_APPROVAL_TOKEN=
TELEGRAM_CHAT_ID=
# Optional for a private owner chat; required for a group chat. Only this user can operate the bot.
TELEGRAM_OWNER_USER_ID=
TELEGRAM_DRY_RUN=true

ENABLE_TRADING=false
ENABLE_TX_SUBMISSION=false
