# Robinhood Chain Research Agent — Phase 1 MVP
# Copy to .env and fill in values. Never commit real secrets.

# Postgres
POSTGRES_USER=rh_research
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=rh_chain
DATABASE_URL=postgresql://rh_research:changeme_local_only@localhost:5432/rh_chain

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Telegram-only proposal decisions: shared API/Telegram service secret (at least 32 random characters).
TELEGRAM_APPROVAL_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_USER_ID=

# Chain (Robinhood Chain)
CHAIN_ID=4663
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com
# Public (rate-limited) or Alchemy / QuickNode HTTPS RPC — collector no-ops when unset
RPC_URL=

# X discovery: opt-in paid API reads, credentials only on collector.
X_DISCOVERY_ENABLED=false
X_BEARER_TOKEN=
X_POLL_MS=300000
X_ACCOUNTS_PER_TICK=1
X_GRAPH_INTERVAL_MS=3600000
X_MAX_GRAPH_USERS=10000

# Public project research, at most hourly per project; no credentials needed for web inspection.
PROJECT_RESEARCH_ENABLED=false
# Optional paid Grok narrative analysis (separate from existing Grok Bot approval handoff).
GROK_RESEARCH_ENABLED=false
XAI_API_KEY=
# Set an available model supporting structured outputs; no assumed model or automatic fallback.
XAI_MODEL=

# Collector (read-only eth_getLogs / eth_call — paper ingest)
COLLECTOR_POLL_MS=15000
LOG_BLOCK_WINDOW=2000
COLLECTOR_LOOKBACK_BLOCKS=5000
# COLLECTOR_CURSOR_PATH=./workers/collector/data/launch-cursor.json

# Web
VITE_API_BASE_URL=http://localhost:3001

# Feature flags — trading paths DISABLED in Phase 1 (must stay false)
ENABLE_TRADING=false
ENABLE_TX_SUBMISSION=false
